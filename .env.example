# Data Room Intelligence configuration.
# Copy to .env and fill in. .env is gitignored; never commit it.
# Access is keyless (Microsoft Entra ID). Your identity needs "Azure AI User" on the
# Foundry project and "Cognitive Services User" on the Document Intelligence resource.
# Verify the setup with: data-room-intel doctor

# Azure identity. For local development, set this to the subscription that owns the
# resources when your Azure CLI default tenant differs (uses `az login`).
# Leave it empty in Azure, where managed identity is used.
AZURE_CLI_SUBSCRIPTION=

# Microsoft Foundry project and model deployments.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Chat and Q&A model.
FOUNDRY_MODEL=gpt-5.4-mini
# Vision-capable model used to interpret PDF charts.
FOUNDRY_VISION_MODEL=gpt-5.4

# Document Intelligence (PDF layout and figure extraction). A Foundry resource
# endpoint works: https://<resource>.cognitiveservices.azure.com/
DOC_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/

# Data room folder (relative paths are repository-relative) and the room ID used for
# snapshots under DRI_DATA_ROOT.
DATA_ROOM_PATH=data/sample-room
DATA_ROOM_ASSET_ID=lone-star-basin

# Optional: where snapshots, reviews and caches are stored (default .dri-data/), and
# DRI_OFFLINE=1 to run from the seeded extraction cache without Azure.
# DRI_DATA_ROOT=.dri-data
# DRI_OFFLINE=1
